# ==============================================================================
# HỆ THỐNG ĐĂNG KÝ HỌC PHẦN (COURSE REGISTRATION SYSTEM) - ENV CONFIGURATION
# ==============================================================================

PROJECT_NAME="Cổng Đăng Ký Học Phần Đại Học"
ENVIRONMENT=development

# ------------------------------------------------------------------------------
# 1. BẢO MẬT & XÁC THỰC (JWT AUTHENTICATION)
# ------------------------------------------------------------------------------
SECRET_KEY=dev-secret-key-change-me-in-production-123456789
ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=1440

# ------------------------------------------------------------------------------
# 2. CẤU HÌNH AWS SECRETS MANAGER (Không hardcode credentials)
# ------------------------------------------------------------------------------
# Khi bật USE_AWS_SECRETS=true, backend sẽ tự động kéo toàn bộ secrets từ
# AWS Secrets Manager về nạp vào biến môi trường trước khi khởi động.
USE_AWS_SECRETS=false
AWS_SECRET_NAME=prod/app/backend
AWS_REGION=ap-southeast-1
AWS_SECRETS_REQUIRED=false

# ------------------------------------------------------------------------------
# 3. CƠ SỞ DỮ LIỆU DYNAMODB (Linh hoạt Local & AWS Cloud)
# ------------------------------------------------------------------------------
# Để test Local mà không cần tài khoản AWS:
# Đặt USE_LOCAL_DYNAMODB=true và DYNAMODB_ENDPOINT_URL=http://dynamodb-local:8000
USE_LOCAL_DYNAMODB=true
DYNAMODB_ENDPOINT_URL=http://dynamodb-local:8000
DYNAMODB_REGION=ap-southeast-1
DYNAMODB_TABLE_PREFIX=

# Khi triển khai lên AWS Cloud:
# USE_LOCAL_DYNAMODB=false
# DYNAMODB_ENDPOINT_URL= (để trống)
# DYNAMODB_REGION=ap-southeast-1

# ------------------------------------------------------------------------------
# 4. HỆ THỐNG GỬI MAIL (EMAIL NOTIFICATIONS - SES / SMTP / MOCK)
# ------------------------------------------------------------------------------
# Các chế độ hỗ trợ:
# - ses     : Dùng AWS Simple Email Service (SES) thông qua boto3
# - smtp    : Dùng SMTP server chuẩn (Gmail, Mailtrap, SendGrid,...)
# - mock    : Chế độ thử nghiệm local, lưu email vào bộ nhớ/DynamoDB để sinh viên xem ngay trên Web UI
# - console : In nội dung email ra terminal / docker log
EMAIL_PROVIDER=mock
DEFAULT_FROM_EMAIL=noreply@course-reg.edu.vn
EMAIL_SUBJECT_PREFIX=Course Registration

# Cấu hình SMTP (nếu EMAIL_PROVIDER=smtp)
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=your-email@gmail.com
SMTP_PASSWORD=your-app-password
SMTP_USE_TLS=true

# ------------------------------------------------------------------------------
# 5. FRONTEND & CORS CONFIGURATION
# ------------------------------------------------------------------------------
VITE_API_BASE_URL=/api
CORS_ALLOWED_ORIGINS=http://localhost:5173,http://localhost:3000,http://localhost:80,*

# ------------------------------------------------------------------------------
# 6. QUY TẮC ĐÀO TẠO & GIỚI HẠN TÍN CHỈ
# ------------------------------------------------------------------------------
MIN_CREDITS=10
MAX_CREDITS=24
